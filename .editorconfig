root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
indent_size = 4

[*.{rs,toml}]
indent_size = 4

[*.{json,yml,yaml,md,txt,scm,sh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{mpack,pdf}]
insert_final_newline = false
trim_trailing_whitespace = false
